# RecoverAI environment variables
# Copy this file to .env and fill in real values as needed.

# Database (defaults to local SQLite if unset)
DATABASE_URL=sqlite:///data/recoverai.db

# Razorpay Test Mode credentials (optional — the project runs fully without these)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# LLM API key for the explanation layer (optional — falls back to a template
# based explanation if unset, see src/agent/prompts.py)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
